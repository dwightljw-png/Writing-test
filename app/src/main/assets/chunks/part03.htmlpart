body.cyber .paper.linePaper{background:repeating-linear-gradient(to bottom,#fff 0,#fff 70px,#dce9fa 71px,#fff 73px)}
body.cyber a{color:#66e9ff}
@media(max-width:760px){body.cyber .cy-writing-watermark{width:min(92vw,650px);top:49%;opacity:.23}
 body.cyber .cy-neon-title{font-size:clamp(12px,2.2vw,17px);letter-spacing:.05em}}
@media(max-width:470px){body.cyber .cy-neon-title{font-size:12.5px;letter-spacing:.02em}
 body.cyber .cy-writing-watermark{width:94vw;opacity:.17}}
@media(prefers-reduced-motion:reduce){body.cyber .cy-bad,body.cyber .btn::before,body.cyber #cyberSwitch::before{animation:none!important}}
}
@media print{#cyberSwitch,.cy-writing-watermark{display:none!important}.cy-neon-title{display:none!important}.cy-original-title{display:inline!important}}

/* v2.0 CYBER hotfix 2: only title/header responsive layout and prompt contrast.
   Preserve exam/game/OCR logic and the light theme controls. */
@media screen{
 body.cyber #previewText.preview{
   background:#0a1c30;
   color:#f5fcff;
   border:1px dashed #4d96c4;
   text-shadow:none;
   box-shadow:inset 0 0 14px rgba(0,232,255,.055);
 }
}
/* Keep the title and API/menu controls on one horizontal row at tablet widths. */
@media screen and (min-width:761px){
 header{flex-wrap:nowrap;align-items:center;gap:8px}
 header .brand{min-width:0;flex:0 1 auto;gap:8px}
 header .brand .logo{flex:0 0 auto}
 header .headerRight{flex:1 1 0;min-width:0;width:auto;flex-wrap:nowrap;gap:6px;justify-content:flex-end}
 header .headerRight .ocrCompact{flex:0 1 auto;min-width:0;gap:5px}
 header .headerRight .ocrCompact .ocrKey{width:clamp(102px,14.3vw,162px);min-width:0;flex:0 1 auto}
 header .headerRight .ocrCompact .ocrSwitch{flex:0 0 auto;padding-left:7px;padding-right:7px;gap:4px}
 header .headerRight #cyberSwitch{flex:0 0 auto;padding:0 8px}
 header .headerRight .tabnav{flex:0 0 auto;min-width:0;width:auto;gap:3px}
 header .headerRight .tabnav button{padding-left:9px;padding-right:9px}
}
@media screen and (min-width:761px) and (max-width:910px){
 header .brand .logo{width:42px;height:42px}
 header .brand p{display:none}
 header .brand h1{line-height:1.1}
 body.cyber .cy-neon-title{font-size:clamp(11.8px,1.62vw,14px);letter-spacing:.02em}
 header .headerRight{gap:4px}
 header .headerRight .ocrCompact{gap:4px}
 header .headerRight .ocrCompact .ocrKey{width:clamp(88px,13vw,112px);font-size:12px;padding-left:7px;padding-right:7px}
 header .headerRight .ocrCompact .ocrSwitch{font-size:12px;padding:0 5px}
 header .headerRight #cyberSwitch{font-size:11px;padding:0 5px}
 header .headerRight .tabnav{gap:1px}
 header .headerRight .tabnav button{font-size:12px;padding-left:5px;padding-right:5px}
}

/* CYBER FIX3: header priority + unmistakable active game cell.
   Presentation only; no change to questions, tile logic, grading or OCR. */
@media screen{
  /* Active slot: light up from within, like the existing CYBER neon action buttons.
     Keep the original navy/cyan hue; no solid yellow fill or layout changes. */
  body.cyber .gameSlot.gameCursor,
  body.cyber .gameSlot.gameCursor.filled,
  body.cyber .gameSlot.gameCursor.spaceFilled{
    border:3px solid #6ff8ff !important;
    background:radial-gradient(ellipse at 50% 13%,rgba(131,255,255,.47) 0%,rgba(0,232,255,.24) 49%,rgba(0,232,255,.06) 87%),
      linear-gradient(180deg,#123c55 0%,#0a2b42 65%,#081b30 100%) !important;
    color:#f7ffff !important;
    box-shadow:0 0 3px 1px rgba(162,255,255,.76),
      0 0 12px 2px rgba(0,232,255,.67),
      0 0 23px 3px rgba(0,232,255,.31),
      inset 0 0 0 1px rgba(201,255,255,.37),
      inset 0 3px 13px rgba(0,232,255,.42),
      inset 0 -9px 12px rgba(0,232,255,.13) !important;
    text-shadow:0 0 2px rgba(255,255,255,.85),0 0 9px rgba(0,232,255,.62);
    position:relative;
    z-index:1;
  }
  /* Maintain clear keyboard focus without changing the slot's color. */
  body.cyber .gameSlot.gameCursor:focus-visible{outline:2px solid #9bf9ff;outline-offset:4px}
}
@media screen and (min-width:761px){
  /* UI mode is a secondary option, and must not dominate main navigation. */
  header .headerRight #cyberSwitch{
    width:58px;min-width:58px;height:34px;min-height:34px;
    padding:0 3px;font-size:10px;line-height:1;gap:0;
  }
  header .headerRight #cyberSwitch .cy-switch-symbol{display:none}
  /* Three primary tabs should be bigger, easier to read and tap. */
  header .headerRight .tabnav{gap:4px}
  header .headerRight .tabnav button{
    min-width:69px;padding-left:11px;padding-right:11px;
    font-size:14px;line-height:1.2;
  }
}
@media screen and (min-width:761px) and (max-width:910px){
  header .headerRight #cyberSwitch{width:52px;min-width:52px;font-size:9.5px;padding:0 1px}
  header .headerRight .tabnav{gap:1px}
  header .headerRight .tabnav button{min-width:62px;font-size:12.5px;padding:0 7px}
}

/* FIX6 — CYBER STIFFENER-style sustained electric arcs while OCR/PDF is actually processing.
   Cosmetic only: isolated to CYBER mode, no DOM changes to grading or networking. */
body.cyber #handOcrWorking.cy-processing{
  position:relative;isolation:isolate;overflow:visible;
  border:1px solid #59eeff;
  background:linear-gradient(100deg,#051221,#062c35 44%,#071426 100%);
  box-shadow:0 0 10px rgba(0,232,255,.42),0 0 35px rgba(0,232,255,.19),
    inset 0 0 27px rgba(0,232,255,.18),inset 0 0 2px #fff;
  animation:cyWorkingCurrent 1.05s ease-in-out infinite alternate;
}
body.cyber #handOcrWorking.cy-processing::before{
  content:"";position:absolute;inset:3px;border:1px solid rgba(185,254,255,.26);
  border-radius:inherit;pointer-events:none;z-index:0;
  box-shadow:inset 0 0 21px rgba(0,232,255,.18);
}
body.cyber #handOcrWorking.cy-processing>b{
  position:relative;z-index:1;color:#f4ffff;
  text-shadow:0 0 5px #fff,0 0 16px #00e8ff,0 0 26px rgba(0,232,255,.7);
}
body.cyber #handOcrWorking.cy-processing #handOcrProgress{position:relative;z-index:1;color:#bdeafa}
body.cyber #importBtn.cy-processing{
  border-color:#c3ffff;background:linear-gradient(100deg,#04101c,#073244,#04101c);
  box-shadow:0 0 12px rgba(0,232,255,.65),0 0 31px rgba(0,232,255,.32),inset 0 0 17px rgba(0,232,255,.28);
  animation:cyWorkingCurrent .95s steps(3,end) infinite;
}
body.cyber #importStatus.cy-processing{color:#aafaff;text-shadow:0 0 10px rgba(0,232,255,.6)}
@keyframes cyWorkingCurrent{0%,100%{filter:brightness(1)}38%{filter:brightness(1.20)}67%{filter:brightness(.88)}73%{filter:brightness(1.40)}}
@media(prefers-reduced-motion:reduce){body.cyber #handOcrWorking.cy-processing,body.cyber #importBtn.cy-processing{animation:none}}
</style>

</head>
<body>
<div class="cy-writing-watermark" aria-hidden="true"><div class="cy-writing-logo"></div><span class="cy-writing-caption">DICTATION TRAINING · STUDY &amp; PLAY</span></div>
<div class="wrap">
<header><div class="brand"><div class="logo" aria-hidden="true">✍️</div><div><h1><span class="cy-original-title">똑똑 받아쓰기</span><span class="cy-neon-title">C<span class="cy-bad">Y</span>BER WRITING <small>v2.1</small></span></h1><p>듣고 · 직접 쓰고 · 오래 기억해요</p></div></div>
<div class="headerRight"><div class="ocrCompact" aria-label="손글씨 OCR 설정"><input id="geminiKey" class="field ocrKey" type="password" placeholder="Google API 키" autocomplete="off" spellcheck="false" aria-label="Google Gemini API 키" title="개인용 API 키. 저장되지 않으며 손글씨 이미지/PDF가 Google로 전송될 수 있습니다."><label class="ocrSwitch" title="시험 종료 시 손글씨 답안을 한 번에 OCR 인식하고 채점"><input type="checkbox" id="ocrToggle"><span>자동채점</span></label></div>
<button id="cyberSwitch" type="button" aria-pressed="false" title="CYBER WRITING UI 켜기"><span class="cy-switch-symbol" aria-hidden="true">◢</span><span class="cy-switch-label">CYBER UI</span></button><nav class="tabnav" aria-label="메뉴"><button id="tabHome" class="active">📖 학습</button><button id="tabRecord">📊 기록</button><button id="tabParent">⚙️ 보호자</button></nav></div></header>
<main>
<section id="homeView">
 <div id="storageWarning" class="callout hidden" role="status" style="margin-bottom:15px">⚠️ 이 브라우저에서는 학습 기록 자동 저장이 차단되어 있습니다. 학습은 가능하지만 창을 닫으면 기록이 사라질 수 있습니다. 보호자 메뉴에서 JSON 백업을 이용하거나 일반 브라우저로 열어 주세요.</div>
 <div class="setupGrid" id="setupArea">
  <article class="card"><div class="between"><div><div class="pill">매일 10분 습관</div><h2 class="sectionTitle topMargin">오늘의 받아쓰기</h2><div class="muted small">정답을 보고 외우는 시간보다 기억해서 쓰는 시간을 늘려요.</div></div><span style="font-size:60px" aria-hidden="true">🌈</span></div>
   <div class="homeFormGrid">
   <div class="formrow"><label for="profile">누가 공부하나요?</label><select class="select" id="profile"></select></div>
   <div class="formrow"><label for="bank">문제 수준</label><select class="select" id="bank"><option value="low">1~2학년 예시 문장</option><option value="mid">3~4학년 예시 문장</option><option value="high">5~6학년 예시 문장</option><option value="custom">우리 학교 받아쓰기</option></select></div>
   <div id="packRow" class="formrow hidden"><label for="pack">학교 / 급수 / 문제 묶음</label><select class="select" id="pack"></select></div>
   <div class="formrow"><label for="mode">공부 방식</label><select id="mode" class="select"><option value="exam">🏫 실전 시험 (정답 숨김)</option><option value="learn">공부하기 (먼저 보기)</option><option value="review">오답 복습 (기한이 된 문제)</option></select></div><select id="count" class="hidden" aria-hidden="true" tabindex="-1"><option value="all" selected>전체 문제</option></select>
   <div class="formrow"><label for="order">출제 순서</label><select id="order" class="select"><option value="sequential">순서대로 (학교 시험 대비)</option><option value="random">무작위로 섞기</option></select></div>
   <div class="formrow"><label for="answerPref">쓰는 방법</label><select id="answerPref" class="select"><option value="type">⌨️ 키보드로 쓰기 · 자동 채점</option><option value="hand">✍️ 태블릿 손글씨 · OCR ON 시 일괄 자동채점</option><option value="paper">📓 공책에 쓰기 · 시험 끝나고 일괄 채점</option></select></div>
   </div><button id="startBtn" class="btn primary big" style="width:100%">🔊 받아쓰기 시험 시작</button><button id="gameStartBtn" class="btn gameStart" type="button">🎮 글자 잡기 게임 <span aria-hidden="true">✨</span></button>
   </article>
  <aside class="card"><h2 class="sectionTitle">이렇게 공부해요</h2>
   <div class="feature"><span class="ico">👀</span><div><b>1. 먼저 읽기</b><div class="muted small">처음 배울 때만 문장을 잠깐 확인해요.</div></div></div>
   <div class="feature"><span class="ico">🔊</span><div><b>2. 듣고 가리고 쓰기</b><div class="muted small">다시 듣기와 느리게 듣기가 가능해요.</div></div></div>
   <div class="feature"><span class="ico">✅</span><div><b>3. 바로 정답 확인</b><div class="muted small">틀려도 괜찮아요. 어디가 다른지 봐요.</div></div></div>
   <div class="feature"><span class="ico">🌱</span><div><b>4. 잊기 전에 다시</b><div class="muted small">오답은 다음 날, 익숙한 문장은 더 나중에 복습해요.</div></div></div>
   <hr class="hr"><div class="miniStats" style="grid-template-columns:1fr 1fr"><div class="mini"><b id="homeDue">0</b><span>오늘 복습 문장</span></div><div class="mini"><b id="homeToday">0</b><span>오늘 풀어 본 문제</span></div></div>
   <div class="notice">🔐 학습 기록은 이 기기의 브라우저에만 저장합니다. 다른 기기로 옮기려면 보호자 메뉴에서 백업하세요.</div>
  </aside>
 </div>

 <article id="gameArea" class="card gameArea hidden" aria-label="글자 잡기 게임">
  <div class="between gameBar"><span class="pill">🎮 글자 잡기 게임</span><button id="gameQuit" class="btn soft" type="button">✕ 나가기</button></div>
  <div class="gameStat"><strong id="gameProgress">1 / 10</strong><span id="gameScore">현재 0점</span></div>
  <div class="progress"><div id="gameProgressFill"></div></div>
  <div id="gameQuestion">
   <div class="gameTitle"><div class="gameMascot" aria-hidden="true">🌟</div><div><h2>소리를 듣고 글자를 잡아요!</h2><p>떠다니는 글자를 골라 빈칸에 순서대로 놓아 보세요.</p></div></div>
   <div class="gameListen"><button id="gameListen" class="btn primary" type="button">🔊 다시 듣기</button><button id="gameSlow" class="btn soft" type="button">🐢 천천히</button></div>
   <h3 class="gameGroupTitle">🧩 문장 조립하기 <span id="gameFillCount" class="gameFillCount"></span></h3>
   <div id="gameSlots" class="gameSlots" aria-label="문장 답안칸"></div>
   <div class="gameActions"><button id="gameSpace" type="button" class="btn soft">↪ 한 칸 비우기</button><button id="gameUndo" type="button" class="btn soft">↶ 한 글자 빼기</button><button id="gameClear" type="button" class="btn soft">🧹 모두 비우기</button></div>
   <h3 class="gameGroupTitle gameFloatingTitle">🫧 떠다니는 글자들 <span id="gameTileCount" class="gameFillCount"></span></h3>
   <div class="gamePool" id="gamePool" aria-label="잡을 수 있는 글자" role="group"></div>
   <p class="gameAssist">글자를 <strong>톡 누르거나 빈칸에 끌어다 놓으세요.</strong> 글자 사이에 빈칸을 남기면 띄어쓰기예요. 마지막 여유 칸은 비워 두어도 돼요.</p>
   <div id="gameFeedback" class="gameFeedback hidden" role="status"></div>
   <div class="gameBottom"><button id="gameCheck" class="btn primary big" type="button">✅ 문장 확인하기</button><button id="gameSkip" class="btn soft" type="button">정답 보기 · 건너뛰기</button><button id="gameNext" class="btn gameNext hidden" type="button">다음 문제 →</button></div>
  </div>
  <div id="gameSummary" class="gameSummary hidden">
   <div class="gameTrophy" aria-hidden="true">🏆</div><h2 id="gameFinishTitle">게임 완료!</h2><div id="gameFinishScore" class="gameFinishScore">100점</div>
   <p id="gameFinishDescription" class="muted"></p><div id="gameMistakes" class="gameMistakes"></div>
   <div class="gameSummaryButtons"><button id="gameReplay" class="btn primary big" type="button">🔄 다시 게임하기</button><button id="gameHome" class="btn soft big" type="button">🏠 학습 화면으로</button></div>
  </div>
 </article>
 <div id="gameCelebrate" class="gameCelebrate hidden" aria-hidden="true"><div class="gameWinText">🎉 100점 만점! 🎉</div></div>
 <article id="studyArea" class="card hidden" aria-live="polite"><div class="between"><span class="pill" id="studyModeBadge">공부하기</span><button id="quitBtn" class="btn soft">✕ 그만하기</button></div><div class="statline topMargin"><b id="progressLabel">1 / 7</b><span id="progressDetail" class="muted small">한 문제씩 차근차근</span></div><div class="progress"><div id="progressFill"></div></div>
  <div id="previewArea" class="hidden"><div class="prompt"><div class="ear">👀</div><h2>먼저 문장을 읽어 보세요</h2><p>문장을 기억해 본 다음 가리고 시작해요.</p></div><div id="previewText" class="preview"></div><div class="btnrow"><button class="btn primary big" id="coverBtn">🙈 가리고 듣기 시작</button></div></div>
  <div id="writeArea" class="hidden"><div class="prompt"><div class="ear">🎧</div><h2>잘 듣고 받아 써 보세요!</h2><p id="soundTip">문장을 다시 듣거나 천천히 들을 수 있어요.</p></div><div class="audioControls"><button id="listenBtn" class="btn primary big">🔊 다시 듣기</button><button id="slowBtn" class="btn secondary big">🐢 천천히</button></div>
  <div class="toolrow"><div class="toggle" role="group" aria-label="답안 작성 방식"><button id="handMode" class="active">✍️ 손글씨</button><button id="typeMode">⌨️ 키보드</button></div><div id="drawingTools" class="btnrow"><button id="undoBtn" class="btn soft">↶ 한 획 취소</button><button id="clearBtn" class="btn soft">지우기</button></div></div>
  <div id="paperArea" class="paperArea hidden"><div class="paperBanner"><div class="paperGlyph">📓</div><div><strong>화면이 아니라 실제 공책에 적어요</strong><p>공책에 현재 문제 번호와 들은 문장을 적어 주세요. 정답은 시험이 끝날 때까지 공개하지 않아요.</p></div></div><div class="btnrow"><button id="paperPrevious" class="btn soft" type="button">← 이전 문제 다시 듣기</button><button id="paperNext" class="btn primary big" type="button">✍️ 공책에 적었어요 · 다음 문제</button></div><p class="small muted">듣기를 다시 누르거나 천천히 들을 수 있어요. 글씨를 다 썼으면 다음 문제로 넘어가세요.</p></div><div id="handArea"><div class="paperTypeChoose"><span class="small muted">노트 모양</span><button type="button" class="btn soft activePaper" id="gridPaperBtn" aria-pressed="true">▦ 칸 공책</button><button type="button" class="btn soft" id="linePaperBtn" aria-pressed="false">☰ 줄 공책</button></div><div class="paper gridPaper" id="paper"><canvas id="ink" aria-label="손가락이나 펜으로 받아쓰기 쓰는 곳"></canvas></div><p class="muted small">손가락 또는 터치펜으로 쓰세요. 칸 공책이 기본입니다. 자동채점 ON이면 문항별 정답은 시험 종료 후에만 보여 줍니다.</p><div class="handBatchBar hidden" id="handBatchBar"><div class="small muted">🔒 정답은 시험을 다 본 뒤에 공개돼요. 다음 문제로 넘어가도 손글씨는 보관됩니다.</div><div class="btnrow"><button type="button" class="btn soft" id="handBatchPrev">← 이전 문제</button><button type="button" class="btn primary big" id="handBatchNext">다음 문제 →</button></div></div></div><div id="typeArea" class="hidden"><label for="typeAnswer" class="small muted">들은 문장을 입력해 주세요.</label><textarea id="typeAnswer" class="answerText" placeholder="들은 대로 여기에 적어 보세요." autocomplete="off" autocapitalize="off" spellcheck="false"></textarea></div>
  <div class="topMargin btnrow" id="checkRow"><button id="checkBtn" class="btn success big">✅ 정답 확인하기</button></div>
  <div id="resultArea" class="result hidden"><h3 id="resultHeading">정답 확인</h3><div class="correctAnswer" id="rightText"></div><div id="typedComparison" class="hidden"><div class="small muted topMargin">내가 쓴 답 (차이가 나는 글자나 띄어쓰기 표시)</div><div id="myText" class="compare"></div></div><div id="hintBox" class="hint hidden"></div><div id="ruleTipArea" class="hidden topMargin" aria-live="polite"></div><div id="feedback" class="feedback">잘했어요!</div><div id="selfGrade" class="hidden"><p class="small muted"><b>손글씨는 자동 인식하지 않아요.</b> 정답을 보고 직접 확인해 주세요.</p><div class="formrow"><label for="selfWrongText" class="small muted">틀리게 쓴 글자나 문장 (선택 · 입력하면 맞춤법 함정을 분석해요)</label><input id="selfWrongText" class="field" autocomplete="off" spellcheck="false" placeholder="공책에 실제로 쓴 오답"></div><div class="btnrow"><button id="selfYes" class="btn success big">😊 맞았어요</button><button id="selfNo" class="btn warn big">🌱 다시 연습할래요</button></div></div><div id="nextActions" class="btnrow hidden"><button id="retryNow" class="btn secondary">🙈 정답 가리고 다시 쓰기</button><button id="nextBtn" class="btn primary big">다음 문제 →</button></div></div>
  </div>
  <div id="handOcrWorking" class="ocrWorking hidden" role="status"><b>🔎 손글씨 답안을 모아서 인식하고 있어요</b><div id="handOcrProgress" class="small muted">정답은 아직 공개하지 않았습니다.</div></div>
  <div id="handOcrReview" class="paperGrade hidden" aria-live="polite"><h2 class="sectionTitle">🔎 손글씨 자동 채점 · 최종 확인</h2><p class="muted small">필기 사진과 인식 글자를 비교하세요. OCR은 띄어쓰기나 글자를 잘못 읽을 수 있습니다. 인식 오류는 수정하고, 필요하면 맞음/틀림을 직접 선택하세요. 점수는 확인 후 저장됩니다.</p><div id="handOcrInfo" class="auditStatus"></div><div id="handOcrRetryTools" class="ocrRetryTools hidden"><div class="small muted">✍️ 작성한 손글씨를 다시 쓰지 않아도 됩니다. 저장된 필기 이미지 그대로 OCR만 다시 시도합니다. 버튼을 누르면 API 요청 1회가 추가되고 사용량·비용이 발생할 수 있습니다. 자동 재시도는 하지 않습니다.</div><div class="btnrow topMargin"><button type="button" id="handOcrRetrySame" class="btn secondary">🔁 같은 모델로 OCR 재시도</button><button type="button" id="handOcrConnTest" class="btn soft">🔌 Google OCR 연결 확인</button></div><div id="handOcrConnStatus" class="small muted topMargin" role="status" aria-live="polite"></div></div><div id="handOcrReviewList"></div><div id="handOcrReviewProgress" class="importCount"></div><button type="button" id="handOcrSave" class="btn success big" style="width:100%" disabled>✅ 채점 확인 후 결과 저장하기</button></div>
  <div id="paperGradeArea" class="paperGrade hidden" aria-live="polite"><h2 class="sectionTitle">📋 공책 시험 전체 답안 확인</h2><p class="muted small">모든 문제를 작성했습니다. 이제 공책과 아래 정답을 비교해 주세요. 각 문항마다 맞음/틀림을 표시해야 결과가 저장됩니다. 스피커로 맞춤법 팁을 들을 수도 있어요.</p><div id="paperGradeProgress" class="importCount"></div><div id="paperGradeList"></div><button id="paperGradeSave" class="btn success big" type="button" style="width:100%" disabled>✅ 채점 결과 저장하고 마치기</button></div>
  <div id="summaryArea" class="hidden"><div class="summaryTop"><div style="font-size:55px">🎉</div><h2>오늘도 한 걸음 성장했어요!</h2><div class="score" id="summaryScore">0%</div><div class="muted" id="summaryLabel"></div></div><div class="miniStats"><div class="mini"><b id="sumTotal">0</b><span>처음 푼 문제</span></div><div class="mini"><b id="sumGood">0</b><span>처음부터 맞힘</span></div><div class="mini"><b id="sumWrong">0</b><span>복습할 문제</span></div></div><div id="wrongList"></div><div class="btnrow topMargin"><button id="retryWrong" class="btn success big hidden">🌱 틀린 문제 다시 연습</button><button id="homeBtn" class="btn primary big">🏠 처음 화면</button></div></div>
 </article>
</section>
<section id="recordView" class="hidden"><article class="card"><h2 class="sectionTitle">📊 나의 학습 기록</h2><p class="muted small">처음 푼 답을 기준으로 기록하며, 오답을 다시 맞혔다고 해서 바로 익힌 것으로 처리하지 않아요.</p><div class="miniStats"><div class="mini"><b id="recordTotal">0</b><span>총 연습 문제</span></div><div class="mini"><b id="recordRate">-</b><span>첫 시도 정답률</span></div><div class="mini"><b id="recordDue">0</b><span>복습할 문장</span></div></div><details class="uiFold"><summary>🎮 글자 잡기 게임 기록</summary><div class="uiFoldBody" id="gameHistory"></div></details><h3>최근 학습일</h3><div id="dayHistory" class="list"></div><details class="uiFold topMargin"><summary>🔎 자주 틀린 맞춤법 · 개인별 분석</summary><div id="weaknessHistory" class="uiFoldBody"></div></details><h3 class="topMargin">복습 대기 문장</h3><div id="dueHistory" class="list"></div></article></section>
<section id="parentView" class="hidden"><div class="grid2"><article class="card"><h2 class="sectionTitle">📂 학교 문제 불러오기</h2><p class="small muted">PDF·Word·Excel·텍스트 파일을 불러온 뒤 원문과 비교해 저장하세요.</p>
   <details class="uiFold"><summary>파일 형식 · 인식 안내</summary><div class="uiFoldBody"><p class="small muted">PDF·TXT·CSV·DOCX·XLSX·HWPX에서 다양한 급수·단계·단원·병렬 표와 문제 수를 분석합니다. 일반 PDF는 글자를 추출하고 스캔본은 API 키가 있을 때 Gemini로 인식합니다. 인식 결과는 반드시 원본과 대조하세요. 구형 HWP·단독 사진은 아직 지원하지 않습니다.</p></div></details>
   <div class="formrow"><label for="importName">문제 묶음 이름</label><input id="importName" class="field" placeholder="예: 우리 학교 2급, 이번 주 시험"></div>
   <div class="btnrow"><button id="importBtn" class="btn secondary" type="button">📄 파일 선택 (PDF 포함)</button><input id="importInput" type="file" accept=".txt,.csv,.tsv,.docx,.xlsx,.hwpx,.pdf,.hwp,.jpg,.jpeg,.png,application/pdf" class="hidden"></div>
   <details class="uiFold"><summary>⚙️ PDF 인식 방식 (기본 자동)</summary><div class="uiFoldBody">   <div class="formrow"><label for="pdfImportMode">PDF 가져오기 방식</label><select id="pdfImportMode" class="select"><option value="auto">자동 · PDF 글자 먼저 읽기, 스캔본은 AI 인식</option><option value="ai">Google AI 문서 인식 · 스캔/복잡한 표에 권장</option><option value="text">PDF 안의 글자만 읽기 · API 사용 안 함</option></select><p class="small muted">일반 PDF의 직접 글자 추출에는 PDF.js를 인터넷으로 처음 불러옵니다. AI 모드는 상단에 Google API 키가 필요하며 PDF 내용이 Google로 전송되고 요금이 발생할 수 있습니다. 2열 표·칸글씨는 AI 모드가 더 잘 해석할 수 있지만 결과를 반드시 검수해야 합니다.</p></div>
   </div></details>
   <details id="pdfOriginalReview" class="hidden topMargin"><summary style="font-weight:750;cursor:pointer">📖 원본 PDF 페이지와 대조하기</summary><p class="small muted"><a id="pdfSourceLink" target="_blank" rel="noopener noreferrer">원본 PDF 새 창으로 열기</a> · 브라우저가 PDF 미리보기를 지원하지 않으면 위 링크로 열어 주세요.</p><iframe id="pdfSourceFrame" title="업로드한 원본 PDF" style="display:block;width:100%;height:440px;border:1px solid #dce5f5;border-radius:14px;background:#fff"></iframe></details>
   <details id="pasteImportBox" class="topMargin"><summary style="cursor:pointer;font-weight:750">📋 문서에서 복사한 내용 분석하기</summary><div class="formrow"><label for="pasteImportText">문장·표 내용을 여기에 붙여넣기</label><textarea id="pasteImportText" class="field" rows="6" placeholder="1급&#10;1. 아침이 밝았어요.&#10;2. 친구와 놀아요.&#10;2단계&#10;1. 꽃이 예뻐요."></textarea></div><button id="pasteImportBtn" class="btn secondary" type="button">붙여넣은 내용 분석</button><p class="muted small">복사한 문장의 순서나 띄어쓰기가 잘못되면 검수 화면에서 수정해 주세요.</p></details><p id="importStatus" class="muted small fileStatus" role="status"></p><div id="importPreview" class="importPreview hidden"></div>