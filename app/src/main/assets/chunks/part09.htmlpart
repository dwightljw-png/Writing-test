 '않':['안','앉','앙'], '안':['않','앉','앙'],'떻':['덕','덧','떡'], '어':['어','여','아'],'게':['개','께','계'],'개':['게','게','걔'],
 '돼':['되','대','데'],'되':['돼','데','대'],'에':['애','의','예'],'애':['에','예','얘'],'예':['에','애','얘'],
 '읽':['익','일','잃'],'잃':['읽','일','익'],'잊':['있','잃','잇'],'있':['잊','잇','이'],'없':['업','엎','얻'],
 '갔':['같','갓','갖'],'같':['갔','갓','갖'],'썼':['썻','섰','쓸'],'었':['엇','았','였'],
 '었':['엇','았','였'],'꽁':['공','콩','꼼'],'뿌':['부','푸','쁘'],'든':['던','돈','든'],
 '느':['누','너','니'],'낮':['낫','낯','낚'],'낫':['낮','낯','낟'],
 '깨':['개','께','게'],'께':['게','깨','개'],'밟':['발','밥','밝'],'짧':['잘','잡','짭'],
 '맞':['맏','맛','맙'],'닦':['닥','닭','딱'],'꽃':['꼿','꽂','꼭'], '기':['끼','키','게'],
 '의':['이','에','으'],'이':['의','히','니'],'히':['이','해','희'],'다':['따','타','대'],
 '더':['덜','도','대'],'한':['함','안','항'],'걸':['껄','걸','건'], '거':['꺼','게','것'],
 '수':['쑤','쏘','소'],'를':['을','률','러'], '을':['를','얼','울'],
 ' ' : [' '], '?':['!','.'], '.':['!','?'], '!':['?','.']
};